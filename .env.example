# ===== Web Download - cấu hình mẫu =====
# Sao chép file này thành ".env" rồi điền giá trị thật.
# Trên Render: khai báo các biến này ở tab "Environment", KHÔNG cần file .env.

# Chạy local thì đặt 3000. Trên Render: để trống, Render tự cấp PORT.
PORT=3000

# Mật khẩu admin ban đầu (chỉ dùng cho lần tạo tài khoản đầu tiên).
# Sau đó đổi qua "Quên mật khẩu?" bằng OTP Gmail.
ADMIN_PASSWORD=Admin@123456

# Email nhận mã OTP khi quên mật khẩu
ADMIN_EMAIL=tmviet98@gmail.com

# Gmail SMTP
# Bật xác thực 2 bước, sau đó tạo App Password tại:
# https://myaccount.google.com/apppasswords
# App Password có thể dán kèm khoảng trắng, hệ thống tự bỏ.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tmviet98@gmail.com
SMTP_PASS=
MAIL_FROM="Web Download" <tmviet98@gmail.com>

# Giới hạn file upload (MB). Render free nên đặt 100.
MAX_UPLOAD_MB=100

# --- Tùy chọn (không bắt buộc) ---

# Thư mục lưu dữ liệu. Trên Render có gắn Persistent Disk thì đặt /var/data
# DATA_DIR=/var/data

# Link ZIP công khai để tự khôi phục file khi server khởi động lại
# (dùng khi ổ đĩa là tạm, ví dụ Render không gắn disk).
# RESTORE_ZIP_URL=

# Địa chỉ công khai của web, dùng để tạo link trong email OTP.
# Ví dụ: https://web-download.onrender.com
# PUBLIC_URL=
